# ==============================================================================
# AI7 Finance — Environment Configuration Template
# Duplicate this file to .env in your root and backend/ directories:
#   cp .env.example backend/.env
# ==============================================================================

# --- Database Configuration ---
# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai7_finance

# --- Security & Authentication ---
# Secret key used for signing JWT tokens.
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_secret_key

# Token expiration in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Web & Server Configuration ---
# The base URL of the web dashboard (used for CORS and OAuth redirects)
APP_BASE_URL=http://localhost:8080

# Local timezone for transaction timestamps and daily pacing resets
TIMEZONE=Asia/Jakarta

# --- Telegram Bot Configuration (Optional for Dual-Mode) ---
# Primary bot token obtained from Telegram @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Master admin Telegram Chat ID for automated pacing alerts & billing watchdog
ALLOWED_USER_ID=your_telegram_chat_id_here

# --- Google OAuth Sign-In (Optional) ---
# Google OAuth 2.0 Client ID (Web Application type from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Google Sheets Snapshot Sync (Optional) ---
# Path to Google Service Account JSON key with Google Sheets API scope enabled
GOOGLE_SERVICE_ACCOUNT_FILE=credentials_google.json

# Default Google Spreadsheet ID to sync daily cycles
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_spreadsheet_id_here

# --- AI Transaction Extractor (Optional: Voice & Receipt OCR) ---
# OpenAI-compatible API endpoint (OpenRouter, Groq, Local Ollama, or Router9)
AI_ROUTER_URL=https://openrouter.ai/api/v1
AI_ROUTER_KEY=your_api_key_here
AI_ROUTER_MODEL=google/gemini-2.0-flash-001

# --- Frontend Environment Variables (Optional) ---
# Direct link to Google Sheets report opened from the web dashboard export menu
NEXT_PUBLIC_GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
